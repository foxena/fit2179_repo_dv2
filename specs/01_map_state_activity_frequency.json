{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where regular activity is strongest",
    "subtitle": "Adults active at least three times per week, 2025, by state/territory"
  },
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states_territories_2021_simplified.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#d8c7ad",
        "strokeWidth": 1.1
      },
      "encoding": {
        "tooltip": null
      }
    },
    {
      "data": {
        "url": "data/ausplay_state_points.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "#fbf8f2",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "rate_pct",
          "type": "quantitative",
          "title": "Rate (%)",
          "scale": {
            "range": [
              450,
              2200
            ]
          },
          "legend": null
        },
        "color": {
          "field": "rate_pct",
          "type": "quantitative",
          "title": "Rate (%)",
          "scale": {
            "scheme": "oranges",
            "domain": [
              45,
              60
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State/territory"
          },
          {
            "field": "rate_pct",
            "type": "quantitative",
            "title": "Active 3+ times/week",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ausplay_state_points.json"
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#334e5c"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_abbr"
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State/territory"
          },
          {
            "field": "rate_pct",
            "type": "quantitative",
            "title": "Active 3+ times/week",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    }
  }
}
