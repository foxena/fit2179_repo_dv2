{
  "title": {
    "text": "Running days cluster rather than spread evenly",
    "subtitle": "Each square is a day with at least one run of 20+ minutes"
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/coros_calendar.json"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "timeUnit": "yearmonthdate",
      "title": null,
      "axis": {
        "format": "%b %Y",
        "labelAngle": -30
      }
    },
    "y": {
      "field": "weekday",
      "type": "ordinal",
      "sort": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
      ],
      "title": null
    },
    "color": {
      "field": "distance_km",
      "type": "quantitative",
      "title": "Distance (km)",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "distance_km",
        "title": "Distance (km)",
        "format": ".1f"
      },
      {
        "field": "activities",
        "title": "Activities"
      },
      {
        "field": "avg_effort",
        "title": "Effort score",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}