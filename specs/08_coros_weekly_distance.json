{
  "title": {
    "text": "Weekly distance shows the rhythm behind the long run",
    "subtitle": "Weekly total running distance from the personal training log"
  },
  "width": "container",
  "height": 310,
  "data": {
    "url": "data/coros_weekly.json"
  },
  "mark": {
    "type": "area",
    "line": {
      "color": "#d97706",
      "strokeWidth": 2
    },
    "color": "#fed7aa",
    "opacity": 0.8
  },
  "encoding": {
    "x": {
      "field": "week_start",
      "type": "temporal",
      "title": null
    },
    "y": {
      "field": "total_distance_km",
      "type": "quantitative",
      "title": "Weekly distance (km)"
    },
    "tooltip": [
      {
        "field": "week_start",
        "type": "temporal",
        "title": "Week starting"
      },
      {
        "field": "total_distance_km",
        "title": "Distance (km)",
        "format": ".1f"
      },
      {
        "field": "activities",
        "title": "Activities"
      },
      {
        "field": "avg_effort",
        "title": "Average effort score",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}