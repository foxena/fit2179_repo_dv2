{
  "title": {
    "text": "Running sits among Australia\u2019s major adult activities",
    "subtitle": "Top adult participation activities by annual participation rate, AusPlay 2025"
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/ausplay_top_activities.json"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 190
      }
    },
    "x": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation rate (%)"
    },
    "color": {
      "field": "highlight",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Running/jogging",
          "Other activity"
        ],
        "range": [
          "#d97706",
          "#d6d3d1"
        ]
      }
    },
    "tooltip": [
      {
        "field": "activity",
        "type": "nominal"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation rate (%)",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}