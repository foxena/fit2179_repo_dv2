{
  "title": {
    "text": "Most running is not formally organised",
    "subtitle": "Any running/jogging versus organised running/jogging, by gender"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/ausplay_running_gender.json"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "gender",
      "type": "nominal",
      "title": null
    },
    "y": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation rate (%)"
    },
    "xOffset": {
      "field": "measure"
    },
    "color": {
      "field": "measure",
      "type": "nominal",
      "title": null,
      "scale": {
        "range": [
          "#d97706",
          "#2563eb"
        ]
      }
    },
    "tooltip": [
      {
        "field": "gender"
      },
      {
        "field": "measure"
      },
      {
        "field": "participation_rate",
        "title": "Participation rate (%)",
        "format": ".1f"
      },
      {
        "field": "estimated_people",
        "title": "Estimated people",
        "format": ",.0f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}