{
  "title": {
    "text": "Heart rate adds effort context to elevation",
    "subtitle": "Average heart rate and elevation gain per kilometre across runs"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/coros_activities.json"
  },
  "transform": [
    {
      "filter": "datum.activity_group !== 'Other training' && datum.avg_hr != null && datum.ascent_per_km != null"
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "opacity": 0.75
  },
  "encoding": {
    "x": {
      "field": "ascent_per_km",
      "type": "quantitative",
      "title": "Elevation gain per km (m/km)"
    },
    "y": {
      "field": "avg_hr",
      "type": "quantitative",
      "title": "Average heart rate (bpm)",
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "distance_band",
      "type": "nominal",
      "title": "Distance band",
      "legend": {
        "columns": 3,
        "labelLimit": 95
      },
      "sort": [
        "<5 km",
        "5–10 km",
        "10–15 km",
        "15–21.1 km",
        "21.1–42.2 km",
        "Ultra / 42.2 km+"
      ]
    },
    "shape": {
      "field": "distance_band",
      "type": "nominal",
      "title": "Distance band",
      "legend": null
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "distance_km",
        "type": "quantitative",
        "title": "Distance (km)",
        "format": ".1f"
      },
      {
        "field": "ascent_per_km",
        "type": "quantitative",
        "title": "m/km",
        "format": ".1f"
      },
      {
        "field": "avg_hr",
        "type": "quantitative",
        "title": "Average HR"
      },
      {
        "field": "effort_score",
        "type": "quantitative",
        "title": "Effort score",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120,
      "columns": 3,
      "labelLimit": 95,
      "titleLimit": 140
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}
