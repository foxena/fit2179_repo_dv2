{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The 50 km run crosses from training into ultra territory",
    "subtitle": "Common race distances compared with the longest training run"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/running_distance_benchmarks.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "opacity": 0.82
      },
      "encoding": {
        "x": {
          "field": "distance_km",
          "type": "quantitative",
          "title": "Distance (km)",
          "scale": {
            "domain": [
              0,
              170
            ]
          }
        },
        "y": {
          "field": "distance_label",
          "type": "ordinal",
          "sort": [
            "5 km",
            "10 km",
            "Half marathon",
            "Marathon",
            "50 km ultra",
            "Longest training run",
            "100 km ultra",
            "100 mile ultra"
          ],
          "title": null
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": null,
          "sort": [
            "Common race distance",
            "Ultra benchmark",
            "Training log"
          ]
        },
        "tooltip": [
          {
            "field": "distance_label",
            "type": "nominal",
            "title": "Distance"
          },
          {
            "field": "distance_km",
            "type": "quantitative",
            "title": "Kilometres",
            "format": ".2f"
          },
          {
            "field": "type",
            "type": "nominal",
            "title": "Type"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontWeight": 650,
        "fontSize": 11,
        "color": "#1f2933"
      },
      "encoding": {
        "x": {
          "field": "distance_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              170
            ]
          }
        },
        "y": {
          "field": "distance_label",
          "type": "ordinal",
          "sort": [
            "5 km",
            "10 km",
            "Half marathon",
            "Marathon",
            "50 km ultra",
            "Longest training run",
            "100 km ultra",
            "100 mile ultra"
          ]
        },
        "text": {
          "field": "display_value",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#0f766e",
        "#9f1239"
      ]
    }
  }
}