{
  "title": {
    "text": "Clubs are only one part of organised running",
    "subtitle": "Where organised adult running/jogging happens, AusPlay 2025"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/ausplay_running_entities.json"
  },
  "transform": [
    {
      "filter": "datum.entity !== 'Total organised'"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "entity",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 190
      }
    },
    "x": {
      "field": "estimated_people",
      "type": "quantitative",
      "title": "Estimated adult participants"
    },
    "color": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Rate (%)",
      "scale": {
        "scheme": "tealblues"
      }
    },
    "tooltip": [
      {
        "field": "entity"
      },
      {
        "field": "participation_rate",
        "title": "Participation rate (%)",
        "format": ".2f"
      },
      {
        "field": "estimated_people",
        "title": "Estimated people",
        "format": ",.0f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}