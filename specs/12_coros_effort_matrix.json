{
  "title": {
    "text": "A custom effort matrix separates hard days from long days",
    "subtitle": "Derived effort score combines heart rate, distance and climbing density"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/coros_effort_matrix.json"
  },
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "stroke": "#fffaf0",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "distance_band",
      "type": "ordinal",
      "sort": [
        "<5 km",
        "5–10 km",
        "10–15 km",
        "15–21.1 km",
        "21.1–42.2 km",
        "Ultra / 42.2 km+"
      ],
      "title": "Distance band"
    },
    "y": {
      "field": "effort_level",
      "type": "ordinal",
      "sort": [
        "Very hard",
        "Hard",
        "Moderate",
        "Low"
      ],
      "title": "Derived effort level"
    },
    "size": {
      "field": "activities",
      "type": "quantitative",
      "title": "Activities",
      "scale": {
        "range": [
          80,
          1800
        ]
      }
    },
    "color": {
      "field": "distance_km",
      "type": "quantitative",
      "title": "Total km",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {
        "field": "distance_band"
      },
      {
        "field": "effort_level"
      },
      {
        "field": "activities"
      },
      {
        "field": "distance_km",
        "title": "Total distance (km)",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569"
      ]
    }
  }
}