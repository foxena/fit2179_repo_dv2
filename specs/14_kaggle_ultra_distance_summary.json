{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Longer ultras are slower and smaller",
    "subtitle": "Median finish time and finisher counts by Australian ultra distance, 2015\u20132022"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/kaggle_aus_ultra_distance_summary.csv"
  },
  "mark": {
    "type": "circle",
    "opacity": 0.82,
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "finishers",
      "type": "quantitative",
      "title": "Finishers in dataset",
      "scale": {
        "type": "sqrt"
      }
    },
    "y": {
      "field": "median_finish_time_hours",
      "type": "quantitative",
      "title": "Median finish time (hours)",
      "scale": {
        "zero": false
      }
    },
    "size": {
      "field": "median_speed_kmh",
      "type": "quantitative",
      "title": "Median speed (km/h)",
      "scale": {
        "range": [
          180,
          950
        ]
      },
      "legend": {
        "title": "Speed (km/h)",
        "values": [
          5.8,
          6.3,
          7.0
        ],
        "format": ".1f",
        "columns": 3,
        "symbolSize": 70,
        "labelLimit": 42,
        "titleLimit": 110
      }
    },
    "color": {
      "field": "distance_group",
      "type": "nominal",
      "title": "Distance",
            "sort": [
                "50 km",
                "100 km",
                "161 km"
            ]
        },
    "tooltip": [
      {
        "field": "distance_group",
        "type": "nominal",
        "title": "Distance"
      },
      {
        "field": "finishers",
        "type": "quantitative",
        "title": "Finishers",
        "format": ","
      },
      {
        "field": "median_speed_kmh",
        "type": "quantitative",
        "title": "Median speed (km/h)",
        "format": ".2f"
      },
      {
        "field": "median_finish_time_hours",
        "type": "quantitative",
        "title": "Median finish time (hr)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120,
      "columns": 3,
      "labelLimit": 120,
      "titleLimit": 140
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569",
        "#0891b2"
      ]
    }
  }
}
