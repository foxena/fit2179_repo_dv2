{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian ultra running is not just one distance",
    "subtitle": "Public Australian ultra results by distance group, 2015\u20132022"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/kaggle_aus_ultra_finishers_by_year.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year_of_event",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "finishers",
      "type": "quantitative",
      "title": "Finishers"
    },
    "color": {
      "field": "distance_group",
      "type": "nominal",
      "title": "Distance",
        "sort": [
          "50 km",
          "100 km",
          "161 km"
        ]
    },
    "tooltip": [
      {
        "field": "year_of_event",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "distance_group",
        "type": "nominal",
        "title": "Distance"
      },
      {
        "field": "finishers",
        "type": "quantitative",
        "title": "Finishers",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569",
        "#0891b2"
      ]
    }
  }
}
