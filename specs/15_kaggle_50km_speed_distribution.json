{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The 50 km effort sits near the middle of Australian 50 km speeds",
    "subtitle": "Training-run speed: 6.81 km/h, approximately the 45th speed percentile from grouped public bands"
  },
  "width": "container",
  "height": 320,
  "layer": [
    {
      "data": {
        "url": "data/kaggle_aus_50km_speed_distribution_augmented.json"
      },
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "speed_band_kmh",
          "type": "ordinal",
          "title": "Average speed band (km/h)",
          "sort": {
            "field": "band_order"
          }
        },
        "y": {
          "field": "finishers",
          "type": "quantitative",
          "title": "Australian 50 km finishers"
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "This training run’s band",
              "Other Australian 50 km results"
            ],
            "range": [
              "#9f1239",
              "#d97706"
            ]
          }
        },
        "tooltip": [
          {
            "field": "speed_band_kmh",
            "type": "ordinal",
            "title": "Speed band"
          },
          {
            "field": "finishers",
            "type": "quantitative",
            "title": "Finishers",
            "format": ","
          },
          {
            "field": "highlight",
            "type": "nominal",
            "title": "Group"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/kaggle_aus_50km_speed_distribution_augmented.json"
      },
      "transform": [
        {
          "filter": "datum.contains_my_run == true"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -8,
        "fontWeight": 700,
        "color": "#9f1239"
      },
      "encoding": {
        "x": {
          "field": "speed_band_kmh",
          "type": "ordinal",
          "sort": {
            "field": "band_order"
          }
        },
        "y": {
          "field": "finishers",
          "type": "quantitative"
        },
        "text": {
          "value": "This 50 km run"
        }
      }
    }
  ],
  "config": {
    "background": "#fffaf0",
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "title": {
      "fontSize": 17,
      "anchor": "start",
      "fontWeight": 700,
      "color": "#1f2933",
      "subtitleColor": "#52616b",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#334e5c",
      "titleColor": "#334e5c",
      "gridColor": "#e9dfd0",
      "domainColor": "#b8aa99",
      "tickColor": "#b8aa99"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "bottom",
      "symbolSize": 120
    },
    "view": {
      "stroke": null
    },
    "range": {
      "category": [
        "#d97706",
        "#2563eb",
        "#0f766e",
        "#9f1239",
        "#6d28d9",
        "#475569",
        "#0891b2"
      ]
    }
  }
}